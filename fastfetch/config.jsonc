{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "\"$(~/.config/fastfetch/starfield-logo.sh)\"",
    "height": 18,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": " ▸ ",
    "color": {
      "keys": "yellow",
      "title": "cyan",
      "output": "default",
      "separator": "yellow"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[1;37m✦ CONSTELLATION\u001b[0m \u001b[31m━━━\u001b[33m━━━\u001b[36m━━━\u001b[34m━━━\u001b[0m \u001b[1;33mSYS.TELEMETRY // 2330\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[33m╭───────────────── \u001b[1;33m[ VESSEL SPEC ]\u001b[0;33m ─────────────────╮\u001b[0m"
    },
    {
      "type": "chassis",
      "key": "  󰇺 Hull     ",
      "keyColor": "blue",
      "format": "{1} {2}"
    },
    {
      "type": "os",
      "key": "  󰣇 NavOS    ",
      "keyColor": "red",
      "format": "{2}"
    },
    {
      "type": "kernel",
      "key": "   Core     ",
      "keyColor": "light_red",
      "format": "{2}"
    },
    {
      "type": "packages",
      "key": "  󰏗 Modules  ",
      "keyColor": "green"
    },
    {
      "type": "display",
      "key": "  󰍹 Viewport ",
      "keyColor": "cyan",
      "format": "{1}x{2} @ {3}Hz"
    },
    {
      "type": "terminal",
      "key": "   Console  ",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": "  󱗃 Sector WM",
      "keyColor": "blue",
      "format": "{2}"
    },
    {
      "type": "custom",
      "format": "\u001b[33m╰───────────────────────────────────────────────────╯\u001b[0m"
    },
    {
      "type": "title",
      "key": "   Explorer ",
      "keyColor": "cyan",
      "format": "{6}{7}{8}"
    },
    {
      "type": "custom",
      "format": "\u001b[34m╭──────────────── \u001b[1;36m[ ASTROGATION ]\u001b[0;34m ──────────────────╮\u001b[0m"
    },
    {
      "type": "cpu",
      "key": "   GravDrive",
      "keyColor": "blue",
      "format": "{1} @ {7}"
    },
    {
      "type": "gpu",
      "key": "  󰊴 Thruster ",
      "keyColor": "cyan",
      "format": "{1} {2}"
    },
    {
      "type": "memory",
      "key": "   Reactor  ",
      "keyColor": "yellow"
    },
    {
      "type": "disk",
      "key": "  󰋊 Cargo Bay",
      "keyColor": "green",
      "folders": "/",
      "format": "{1} / {2} ({3})"
    },
    {
      "type": "disk",
      "key": "  󱦟 Sols Log ",
      "keyColor": "light_red",
      "folders": "/",
      "format": "{days} days"
    },
    {
      "type": "uptime",
      "key": "  󱫐 Mission  ",
      "keyColor": "red"
    },
    {
      "type": "custom",
      "format": "\u001b[34m╰───────────────────────────────────────────────────╯\u001b[0m"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
