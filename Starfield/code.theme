  "semanticHighlighting": true,
  "semanticTokenColors": {
    "enumMember": {
      "foreground": "#3D516C"
    },
    "selfKeyword": {
      "foreground": "#B72B3C"
    },
    "boolean": {
      "foreground": "#C2511F"
    },
    "number": {
      "foreground": "#C2511F"
    },
    "variable.defaultLibrary": {
      "foreground": "#5A3E7A"
    },
    "class:python": {
      "foreground": "#966814"
    },
    "class.builtin:python": {
      "foreground": "#B72B3C"
    },
    "variable.typeHint:python": {
      "foreground": "#966814"
    },
    "function.decorator:python": {
      "foreground": "#C2511F"
    },
    "variable.readonly:javascript": {
      "foreground": "#1B263B"
    },
    "variable.readonly:typescript": {
      "foreground": "#1B263B"
    },
    "property.readonly:javascript": {
      "foreground": "#1B263B"
    },
    "property.readonly:typescript": {
      "foreground": "#1B263B"
    },
    "variable.readonly:javascriptreact": {
      "foreground": "#1B263B"
    },
    "variable.readonly:typescriptreact": {
      "foreground": "#1B263B"
    },
    "property.readonly:javascriptreact": {
      "foreground": "#1B263B"
    },
    "property.readonly:typescriptreact": {
      "foreground": "#1B263B"
    },
    "variable.readonly:scala": {
      "foreground": "#1B263B"
    },
    "type.defaultLibrary:go": {
      "foreground": "#B72B3C"
    },
    "variable.readonly.defaultLibrary:go": {
      "foreground": "#B72B3C"
    },
    "tomlArrayKey": {
      "foreground": "#1E4D7B",
      "fontStyle": ""
    },
    "tomlTableKey": {
      "foreground": "#1E4D7B",
      "fontStyle": ""
    },
    "builtinAttribute.attribute.library:rust": {
      "foreground": "#1E4D7B"
    },
    "generic.attribute:rust": {
      "foreground": "#1B263B"
    },
    "constant.builtin.readonly:nix": {
      "foreground": "#B72B3C"
    },
    "heading": {
      "foreground": "#B72B3C"
    },
    "text.emph": {
      "foreground": "#B72B3C",
      "fontStyle": "italic"
    },
    "text.strong": {
      "foreground": "#B72B3C",
      "fontStyle": "bold"
    },
    "text.math": {
      "foreground": "#7A3B6E"
    },
    "pol": {
      "foreground": "#7A3B6E"
    }
  },
  "tokenColors": [
    {
      "name": "Basic text & variable names (incl. leading punctuation)",
      "scope": [
        "text",
        "source",
        "variable.other.readwrite",
        "punctuation.definition.variable"
      ],
      "settings": {
        "foreground": "#1B263B"
      }
    },
    {
      "name": "Parentheses, Brackets, Braces",
      "scope": "punctuation",
      "settings": {
        "foreground": "#2E5A88",
        "fontStyle": ""
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#64778D",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#1E6B4B"
      }
    },
    {
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#7A3B6E"
      }
    },
    {
      "name": "Booleans, constants, numbers",
      "scope": [
        "constant.numeric",
        "variable.other.constant",
        "entity.name.constant",
        "constant.language.boolean",
        "constant.language.false",
        "constant.language.true",
        "keyword.other.unit.user-defined",
        "keyword.other.unit.suffix.floating-point"
      ],
      "settings": {
        "foreground": "#C2511F"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.operator.word",
        "keyword.operator.new",
        "variable.language.super",
        "support.type.primitive",
        "storage.type",
        "storage.modifier",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#B72B3C",
        "fontStyle": ""
      }
    },
    {
      "scope": "entity.name.tag.documentation",
      "settings": {
        "foreground": "#B72B3C"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.definition.generic",
        "meta.function.closure punctuation.section.parameters",
        "punctuation.definition.tag",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#3D516C"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call.method",
        "support.function",
        "support.function.misc",
        "variable.function"
      ],
      "settings": {
        "foreground": "#1E4D7B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Classes",
      "scope": [
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "meta.function-call.constructor",
        "entity.name.struct"
      ],
      "settings": {
        "foreground": "#966814",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Enum",
      "scope": "entity.name.enum",
      "settings": {
        "foreground": "#966814",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Enum member",
      "scope": [
        "meta.enum variable.other.readwrite",
